# ===================================================
# WOWTEK ORDER MANAGEMENT SYSTEM (WOWTEK OMS)
# Environment Configuration (.env.example)
# Business: WOWTEK — Sri Lanka | Website: wowtek.lk
# ===================================================

# Application
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Database: MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wowtek_oms?retryWrites=true&w=majority
MONGODB_DB_NAME=wowtek_oms

# WooCommerce Integration
# Configure WooCommerce REST API keys and webhook secret from WooCommerce > Settings > Advanced > REST API / Webhooks
WOOCOMMERCE_URL=https://wowtek.lk
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PickMe Food & Merchant Integration
# Official credentials provided by PickMe Sri Lanka Partner Portal
PICKME_API_URL=https://api.pickme.lk/merchant/v1
PICKME_API_KEY=
PICKME_API_SECRET=
PICKME_MERCHANT_ID=

# Uber Eats Integration
# Official credentials provided by Uber Eats Developer Portal
UBER_API_URL=https://api.uber.com/v1/eats
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_ACCESS_TOKEN=

# Transport & Courier — Trans Express Sri Lanka
# Official credentials provided by Trans Express Courier Systems
TRANSEX_API_URL=https://api.transexpress.lk/v1
TRANSEX_API_KEY=
TRANSEX_API_SECRET=
TRANSEX_ACCOUNT_ID=

# SMS Gateway Integration (Sri Lanka Telecom / Mobitel / Dialog / Generic Gateway)
SMS_API_URL=https://api.sms.lk/v2/send
SMS_API_KEY=
SMS_SENDER_ID=WOWTEK

# Gemini AI (for smart order categorization and assistant)
GEMINI_API_KEY=
